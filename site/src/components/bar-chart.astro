---
export interface ChartSeries {
  key: "world-cup" | "continental" | "olympic" | "coverage";
  label: string;
  color:
    | "var(--color-chart-world)"
    | "var(--color-chart-continental)"
    | "var(--color-chart-olympic)";
}

export interface ChartSegment extends ChartSeries {
  value: number;
}

export interface ChartItem {
  label: string;
  meta?: string;
  href?: string;
  total: number;
  accessibleLabel: string;
  segments: ChartSegment[];
}

interface Props {
  title: string;
  description: string;
  items: ChartItem[];
  series: ChartSeries[];
  ariaLabel: string;
}

const { title, description, items, series, ariaLabel } = Astro.props;
const max = Math.max(...items.map((item) => item.total), 1);
---

<section class="chart" aria-label={ariaLabel}>
  <header class="chart__head">
    <div>
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
    {series.length > 1 && (
      <ul class="chart__legend" aria-label={ariaLabel}>
        {series.map((entry) => (
          <li>
            <i style={`--series-color: ${entry.color}`} aria-hidden="true"></i>{entry.label}
          </li>
        ))}
      </ul>
    )}
  </header>

  <ol class="chart__rows">
    {items.map((item) => (
      <li>
        <span class="chart__name">
          {item.href ? <a href={item.href}>{item.label}</a> : item.label}
          {item.meta && <small>{item.meta}</small>}
        </span>
        <span class="chart__track" aria-hidden="true">
          {item.segments.map((segment) => (
            <i
              style={`--bar-size: ${(segment.value / max) * 100}%; --series-color: ${segment.color}`}
            ></i>
          ))}
        </span>
        <strong class="chart__total tnum">{item.total}</strong>
        <span class="visually-hidden">{item.accessibleLabel}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .chart {
    min-width: 0;
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-container);
    background: var(--color-paper);
    box-shadow: var(--shadow-whisper);
  }

  .chart__head {
    display: grid;
    gap: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: var(--text-lg);
  }

  p {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .chart__legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    white-space: nowrap;
  }

  .chart__legend i {
    inline-size: var(--space-xs);
    block-size: var(--space-xs);
    border-radius: var(--radius-cell);
    background: var(--series-color);
  }

  .chart__rows {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chart__rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
  }

  .chart__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-sm);
  }

  .chart__name a {
    font-weight: 600;
    white-space: nowrap;
  }

  .chart__name small {
    margin-inline-start: var(--space-2xs);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .chart__track {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    min-width: 0;
    block-size: var(--space-sm);
    overflow: hidden;
    border-radius: var(--radius-full);
    background: var(--color-chart-track);
  }

  .chart__track i {
    flex: 0 0 var(--bar-size);
    block-size: 100%;
    background: var(--series-color);
  }

  .chart__total {
    min-width: 2ch;
    font-size: var(--text-sm);
    text-align: end;
  }

  @media (min-width: 40rem) {
    .chart__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .chart__rows li {
      grid-template-columns: minmax(0, var(--size-chart-label)) minmax(4rem, 1fr) auto;
    }

    .chart__track {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
