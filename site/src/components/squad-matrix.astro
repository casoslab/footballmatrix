---
import { ABSENT, yearLabel, type CountryModel } from "../lib/data";
import { countryName, hrefPlayer, t, tournamentName, type Lang } from "../lib/i18n";
import { fmtNumber } from "../lib/format";

interface Props {
  model: CountryModel;
  lang: Lang;
}

const { model, lang } = Astro.props;
const { country, tournaments, rows } = model;

const name = countryName(country, lang);
---

<section
  class="matrix"
  aria-labelledby="matrix-heading"
  data-locale={lang === "tr" ? "tr-TR" : "en-GB"}
  data-count-template={t(lang, "matrix.resultCount", { count: "__COUNT__" })}
>
  <h2 id="matrix-heading">{t(lang, "country.matrixHeading")}</h2>
  <p class="matrix__intro">{t(lang, "country.intro")}</p>

  <div class="matrix__controls">
    <label class="matrix__search">
      <span class="matrix__label">{t(lang, "matrix.searchAria")}</span>
      <input
        type="search"
        id="matrix-search"
        autocomplete="off"
        placeholder={t(lang, "matrix.searchPlaceholder")}
      />
    </label>

    <label class="matrix__toggle">
      <input type="checkbox" id="matrix-repeat-only" />
      <span>{t(lang, "matrix.repeatOnly")}</span>
    </label>

    <p class="matrix__count" id="matrix-count" role="status" aria-live="polite">
      {t(lang, "matrix.resultCount", { count: fmtNumber(lang, rows.length) })}
    </p>
  </div>

  <div
    class="matrix__scroll"
    id="matrix-scroll"
    role="region"
    aria-label={t(lang, "matrix.scrollAria")}
    tabindex="0"
  >
    <table id="matrix-table">
      <caption class="visually-hidden">{t(lang, "matrix.caption", { country: name })}</caption>

      <thead>
        <tr>
          <th scope="col" class="col-player" aria-sort="none">
            <button type="button" data-column="0" data-type="text"
              aria-label={t(lang, "matrix.sortAria", { label: t(lang, "matrix.colPlayer") })}>
              <span class="col-group">{name}</span>{t(lang, "matrix.colPlayer")}
              <i class="sort-mark" aria-hidden="true"></i>
            </button>
          </th>
          <th scope="col" class="col-meta" aria-sort="none">
            <button type="button" data-column="1" data-type="number"
              aria-label={t(lang, "matrix.sortAria", { label: t(lang, "matrix.colBirth") })}>
              <span class="col-group">{t(lang, "matrix.groupInfo")}</span>{t(lang, "matrix.colBirth")}
              <i class="sort-mark" aria-hidden="true"></i>
            </button>
          </th>
          <th scope="col" class="col-meta" aria-sort="none">
            <button type="button" data-column="2" data-type="text"
              aria-label={t(lang, "matrix.sortAria", { label: t(lang, "matrix.colPosition") })}>
              <span class="col-group">{t(lang, "matrix.groupInfo")}</span>{t(lang, "matrix.colPosition")}
              <i class="sort-mark" aria-hidden="true"></i>
            </button>
          </th>
          <th scope="col" class="col-meta" aria-sort="descending">
            <button type="button" data-column="3" data-type="number" class="is-desc"
              aria-label={t(lang, "matrix.sortAria", { label: t(lang, "matrix.colCount") })}>
              <span class="col-group">{t(lang, "matrix.groupApps")}</span>{t(lang, "matrix.colCount")}
              <i class="sort-mark" aria-hidden="true"></i>
            </button>
          </th>
          {tournaments.map((tournament, index) => (
            <th scope="col" class={`col-year is-${tournament.type}`} aria-sort="none">
              <button type="button" data-column={4 + index} data-type="number"
                aria-label={t(lang, "matrix.sortAria", {
                  label: `${tournamentName(tournament, lang)} ${yearLabel(tournament)}`,
                })}>
                <span class="col-group">{tournamentName(tournament, lang)}</span>
                {yearLabel(tournament)}
                <i class="sort-mark" aria-hidden="true"></i>
              </button>
            </th>
          ))}
        </tr>
      </thead>

      <tbody id="matrix-body">
        {rows.map((row) => (
          <tr data-name={row.normalizedName} data-count={row.tournamentCount}>
            <th scope="row" class="col-player">
              <a href={hrefPlayer(lang, row.player.id)}>{row.player.name}</a>
            </th>
            <td class="col-meta tnum">{row.player.birthYear ?? t(lang, "common.unknown")}</td>
            <td class="col-meta">
              {row.player.position ?? <span class="is-unknown">{t(lang, "common.unknown")}</span>}
            </td>
            <td class="col-meta tnum">{row.tournamentCount}</td>
            {row.cells.map((cell) => (
              <td class={`col-year tnum ${cell === ABSENT ? "is-absent" : "is-present"}`}>
                {cell === ABSENT ? "–" : (cell ?? "n/a")}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="matrix__empty" id="matrix-empty" hidden>{t(lang, "matrix.empty")}</p>

  <ul class="matrix__legend">
    <li><span class="swatch is-present tnum">10</span>{t(lang, "matrix.legendPresent")}</li>
    <li><span class="swatch is-absent">–</span>{t(lang, "matrix.legendAbsent")}</li>
    <li><span class="swatch is-present">n/a</span>{t(lang, "matrix.legendNa")}</li>
  </ul>

  <p class="matrix__note">{t(lang, "country.positionNote")}</p>
</section>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>(".matrix");
    if (!root) return;
    const locale = root.dataset.locale!;
    const countTemplate = root.dataset.countTemplate!;

    const search = document.getElementById("matrix-search") as HTMLInputElement | null;
    const repeatOnly = document.getElementById("matrix-repeat-only") as HTMLInputElement | null;
    const body = document.getElementById("matrix-body") as HTMLTableSectionElement | null;
    const count = document.getElementById("matrix-count");
    const empty = document.getElementById("matrix-empty");
    const scroll = document.getElementById("matrix-scroll");
    if (!search || !repeatOnly || !body || !count || !empty || !scroll) return;

    const rows = Array.from(body.rows);

    /* Same normalisation the dataset was built with: Turkish casing first,
       then strip diacritics. Doing this in the wrong order makes "İ" and "I"
       collapse into each other and Turkish search fails silently. */
    const normalize = (value: string) =>
      value.toLocaleLowerCase(locale).normalize("NFD").replace(/[̀-ͯ]/g, "");

    const applyFilters = () => {
      const query = normalize(search.value.trim());
      const repeatsOnly = repeatOnly.checked;
      let visible = 0;
      for (const row of rows) {
        const show =
          row.dataset.name!.includes(query) &&
          (!repeatsOnly || Number(row.dataset.count) > 1);
        row.hidden = !show;
        if (show) visible += 1;
      }
      count.textContent = countTemplate.replace("__COUNT__", visible.toLocaleString(locale));
      empty.hidden = visible > 0;
      count.classList.add("is-updating");
      requestAnimationFrame(() => count.classList.remove("is-updating"));
    };

    search.addEventListener("input", applyFilters);
    repeatOnly.addEventListener("change", applyFilters);

    /* ---- Sorting ---------------------------------------------------- */
    const cellValue = (row: HTMLTableRowElement, column: number) =>
      row.children[column]!.textContent!.trim();

    const compare = (
      a: HTMLTableRowElement,
      b: HTMLTableRowElement,
      column: number,
      type: string,
      direction: string,
    ) => {
      const sign = direction === "asc" ? 1 : -1;
      if (type === "number") {
        /* "–" (absent) and "n/a" (present, no shirt number) are not zero.
           They sort to the bottom in both directions, so the first screen of
           a sorted column is always real data. */
        const parse = (row: HTMLTableRowElement) => {
          const raw = cellValue(row, column);
          const value = Number.parseInt(raw, 10);
          return Number.isNaN(value) ? null : value;
        };
        const av = parse(a);
        const bv = parse(b);
        if (av === null && bv === null) return 0;
        if (av === null) return 1;
        if (bv === null) return -1;
        return (av - bv) * sign;
      }
      return cellValue(a, column).localeCompare(cellValue(b, column), locale, {
        sensitivity: "base",
      }) * sign;
    };

    let active = { column: 3, direction: "desc" };

    const sortBy = (column: number, type: string, direction: string) => {
      const sorted = rows.slice().sort((a, b) => {
        const result = compare(a, b, column, type, direction);
        /* Stable tiebreak on the player name so equal cells never shuffle. */
        return result !== 0
          ? result
          : cellValue(a, 0).localeCompare(cellValue(b, 0), locale, { sensitivity: "base" });
      });
      const fragment = document.createDocumentFragment();
      for (const row of sorted) fragment.appendChild(row);
      body.appendChild(fragment);
      active = { column, direction };

      for (const header of document.querySelectorAll("#matrix-table thead th")) {
        const button = header.querySelector("button")!;
        const isActive = Number(button.dataset.column) === column;
        header.setAttribute("aria-sort", isActive ? (direction === "asc" ? "ascending" : "descending") : "none");
        button.classList.toggle("is-asc", isActive && direction === "asc");
        button.classList.toggle("is-desc", isActive && direction === "desc");
      }
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "#matrix-table thead button",
    )) {
      button.addEventListener("click", () => {
        const column = Number(button.dataset.column);
        const type = button.dataset.type!;
        /* Text columns open ascending, numeric columns open descending —
           "most tournaments first" is the useful default for a count. */
        const direction =
          active.column === column
            ? active.direction === "asc"
              ? "desc"
              : "asc"
            : type === "number"
              ? "desc"
              : "asc";
        sortBy(column, type, direction);
      });
    }

    /* ---- Sticky-column shadow, only once scrolled ------------------- */
    scroll.addEventListener(
      "scroll",
      () => scroll.classList.toggle("is-scrolled", scroll.scrollLeft > 0),
      { passive: true },
    );
  })();
</script>

<style>
  .matrix {
    margin-block-start: var(--space-3xl);
  }

  .matrix h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-display);
    margin: 0;
  }

  .matrix__intro,
  .matrix__note {
    max-width: 65ch;
    color: var(--color-ink-muted);
    margin-block: var(--space-sm) 0;
  }

  .matrix__note {
    margin-block-start: var(--space-lg);
    font-size: var(--text-sm);
  }

  /* ---- Controls ---------------------------------------------------- */
  .matrix__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-block: var(--space-lg) var(--space-sm);
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-control);
    background: var(--color-paper-2);
  }

  .matrix__search {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .matrix__label {
    display: block;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-block-end: var(--space-2xs);
  }

  .matrix__search input {
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    font: inherit;
    color: var(--color-ink);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule-strong);
    border-radius: var(--radius-control);
  }

  .matrix__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
  }

  .matrix__toggle input {
    accent-color: var(--color-accent);
  }

  .matrix__count {
    flex-basis: 100%;
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .matrix__count.is-updating {
    opacity: 0.55;
  }

  .matrix__empty {
    margin-block-start: var(--space-lg);
    color: var(--color-ink-muted);
  }

  /* ---- Scrollport --------------------------------------------------
     The horizontal scroll lives here and nowhere else. The page body
     must never scroll sideways, at any width. */
  .matrix__scroll {
    overflow: auto;
    max-height: var(--matrix-max-height);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-container);
    background: var(--color-paper);
  }

  .matrix__scroll:focus-visible {
    outline: var(--rule-focus) solid var(--color-focus);
    outline-offset: 2px;
  }

  table {
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Header ------------------------------------------------------ */
  thead th {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-header);
    padding: 0;
    text-align: start;
    vertical-align: bottom;
    background: var(--color-paper-2);
    border-block-end: var(--rule-double) solid var(--color-ink);
    white-space: nowrap;
  }

  thead th.col-player {
    left: 0;
    z-index: var(--z-sticky-corner);
    width: var(--size-player-column);
  }

  thead button {
    display: block;
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    text-align: start;
    background: none;
    border: 0;
    cursor: pointer;
  }

  thead button:hover {
    background: var(--color-paper-3);
  }

  thead button:focus-visible {
    outline: var(--rule-focus) solid var(--color-focus);
    outline-offset: -2px;
  }

  .col-group {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .sort-mark::after {
    content: "";
    display: inline-block;
    inline-size: 0.5em;
  }

  button.is-asc .sort-mark::after {
    content: "↑";
    color: var(--color-accent);
  }

  button.is-desc .sort-mark::after {
    content: "↓";
    color: var(--color-accent);
  }

  /* Tournament family is carried by a rule weight, not a fill colour. */
  th.is-world-cup {
    border-block-end-color: var(--color-accent);
  }

  th.is-olympic {
    border-block-end-style: dashed;
  }

  /* ---- Body -------------------------------------------------------- */
  tbody th,
  tbody td {
    padding: var(--space-2xs) var(--space-sm);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    white-space: nowrap;
  }

  tbody th.col-player {
    position: sticky;
    left: 0;
    z-index: var(--z-sticky-column);
    width: var(--size-player-column);
    max-width: var(--size-player-column);
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 400;
    text-align: start;
    background: var(--color-paper);
  }

  tbody tr:hover th.col-player,
  tbody tr:hover td {
    background: var(--color-paper-2);
  }

  tbody a {
    color: inherit;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: var(--rule-underline-offset);
  }

  tbody a:hover {
    text-decoration-color: var(--color-accent);
  }

  tbody a:focus-visible {
    outline: var(--rule-focus) solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-cell);
  }

  .col-year {
    min-width: var(--size-year-column);
    text-align: end;
  }

  /* Presence is weight, not colour: a heat map would fail colour-blind
     readers and nobody asked for one. */
  .is-present {
    font-family: var(--font-outlier);
    color: var(--color-ink);
  }

  .is-absent {
    color: var(--color-ink-muted);
  }

  .is-unknown {
    color: var(--color-ink-muted);
    font-style: normal;
  }

  /* The sticky column only casts a shadow once it actually overlaps. */
  .matrix__scroll.is-scrolled th.col-player {
    box-shadow: 4px 0 8px -6px var(--color-shadow);
  }

  /* ---- Legend ------------------------------------------------------ */
  .matrix__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block: var(--space-md) 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .matrix__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .swatch {
    display: inline-block;
    min-inline-size: 2.25em;
    padding: 0 var(--space-2xs);
    text-align: end;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-cell);
    background: var(--color-paper);
  }

  @media (min-width: 40rem) {
    .matrix__count {
      flex-basis: auto;
      margin-inline-start: auto;
    }
  }
</style>
